{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GForce delta anchors (skill overrides against an upstream source)",
  "type": "object",
  "required": [
    "source",
    "overrides"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "overrides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "upstream_paths",
          "tripwires",
          "gforce_rule",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "$comment": {
            "type": "string"
          },
          "upstream_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tripwires": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "gforce_rule": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "delta": {
            "type": "string"
          }
        }
      }
    }
  }
}
