{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GForce upstream catalog-of-record",
  "type": "object",
  "required": [
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "ref",
          "ratified_commit",
          "ratified_on",
          "skills"
        ],
        "additionalProperties": false,
        "properties": {
          "$comment": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "ratified_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "ratified_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "path",
                "marker"
              ],
              "additionalProperties": false,
              "properties": {
                "$comment": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "marker": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
